{
  "schema_version": 1,
  "journey": "J-04",
  "name": "Ingestion-path equivalence under an identical valid event stream",
  "default_timeout_ms": 8000,
  "steps": [
    {"n": 1, "journey": "J-04", "action": {"type": "goto", "url": "/"}, "expect": {"text": "No ticker watched"}},
    {"n": 2, "journey": "J-04", "action": {"type": "click", "target": {"role": "button", "name": "Simulated"}}},
    {"n": 3, "journey": "J-04", "action": {"type": "fill", "target": {"placeholder": "Ticker e.g. SIM-BUYER"}, "text": "SIM-BIDABS"}},
    {"n": 4, "journey": "J-04", "action": {"type": "click", "target": {"role": "button", "name": "Watch"}}, "expect": {"text": "live"}},
    {"n": 5, "journey": "J-04", "action": {"type": "click", "target": {"role": "button", "name": "Pause"}}, "expect": {"text": "paused"}},
    {"n": 6, "journey": "J-04", "action": {"type": "goto", "url": "/tape/SIM-BIDABS/observation"}, "expect": {"text": "\"observation_hash\""}},
    {"n": 7, "journey": "J-04", "action": {"type": "goto", "url": "/tape/SIM-BIDABS/observation"}, "expect": {"text": "\"observation_hash\""}}
  ]
}
