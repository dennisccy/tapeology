{
  "schema_version": 1,
  "journey": "J-10",
  "name": "The kept product stands — traps armed, sentinel green",
  "default_timeout_ms": 20000,
  "steps": [
    {"n": 1, "journey": "J-10", "action": {"type": "goto", "url": "/"}, "expect": {"text": "No ticker watched"}},
    {"n": 2, "journey": "J-10", "action": {"type": "fill", "target": {"label": "Ticker"}, "text": "SIM-BUYER"}},
    {"n": 3, "journey": "J-10", "action": {"type": "click", "target": {"role": "button", "name": "Watch"}}, "expect": {"text": "Buyer Control"}},
    {"n": 4, "journey": "J-10", "action": {"type": "goto", "url": "/structure"}, "expect": {"text": "Tradable Map"}},
    {"n": 5, "journey": "J-10", "action": {"type": "fill", "target": {"label": "Structure symbol"}, "text": "AAPL"}},
    {"n": 6, "journey": "J-10", "action": {"type": "fill", "target": {"testid": "structure-as-of-input"}, "text": "2026-06-22 16:00:00"}},
    {"n": 7, "journey": "J-10", "action": {"type": "click", "target": {"testid": "structure-load-button"}}, "expect": {"text": "300.11–302.2"}},
    {"n": 8, "journey": "J-10", "action": {"type": "goto", "url": "/desk"}, "expect": {"text": "Playbook Signals"}},
    {"n": 9, "journey": "J-10", "action": {"type": "click", "target": {"testid": "desk-section-expand-playbookEvidence"}}, "expect": {"text": "Built from signature:"}},
    {"n": 10, "journey": "J-10", "action": {"type": "fill", "target": {"testid": "desk-playbook-date-input"}, "text": "2026-06-22"}, "expect": {"text": "recorded signals, none hidden"}},
    {"n": 11, "journey": "J-10", "action": {"type": "click", "target": {"testid": "desk-section-expand-microReadiness"}}, "expect": {"text": "Distinct symbol-days"}},
    {"n": 12, "journey": "J-10", "action": {"type": "click", "target": {"testid": "desk-section-expand-scoutLedger"}}, "expect": {"text": "No candidates ledgered."}},
    {"n": 13, "journey": "J-10", "action": {"type": "click", "target": {"testid": "desk-section-expand-walkForward"}}, "expect": {"text": "No fold specs registered."}},
    {"n": 14, "journey": "J-10", "action": {"type": "click", "target": {"testid": "desk-section-expand-validationVault"}}, "expect": {"text": "iter18-qa-universe"}},
    {"n": 15, "journey": "J-10", "action": {"type": "click", "target": {"testid": "desk-section-expand-refereeRegistry"}}, "expect": {"text": "config fingerprint 08e471b10130e1e2"}},
    {"n": 16, "journey": "J-10", "action": {"type": "click", "target": {"testid": "desk-section-expand-refereeAdjudications"}}, "expect": {"text": "No hypotheses registered."}},
    {"n": 17, "journey": "J-10", "action": {"type": "click", "target": {"testid": "desk-section-expand-refereeRuns"}}, "expect": {"text": "No evaluation runs recorded yet."}}
  ]
}
