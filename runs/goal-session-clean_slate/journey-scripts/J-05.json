{
  "schema_version": 1,
  "journey": "J-05",
  "name": "The kept product stands — regression sentinel (full walk: sim cockpit settle + chart timeframe switch + stop-reset, /structure Load wall band, Case Studies drill-in)",
  "default_timeout_ms": 20000,
  "steps": [
    {"n": 1, "journey": "J-05", "action": {"type": "goto", "url": "/"}, "expect": {"text": "No ticker watched"}},
    {"n": 2, "journey": "J-05", "action": {"type": "fill", "target": {"placeholder": "Ticker e.g. SIM-BUYER"}, "text": "SIM-BUYER"}},
    {"n": 3, "journey": "J-05", "action": {"type": "click", "target": {"role": "button", "name": "Watch"}}, "expect": {"text": "Buyer Control"}},
    {"n": 4, "journey": "J-05", "action": {"type": "click", "target": {"css": "[aria-label=\"Tape bar size\"] button:nth-of-type(2)"}}, "expect": {"text": "Logical 30s bars built live from the tape."}},
    {"n": 5, "journey": "J-05", "action": {"type": "click", "target": {"role": "button", "name": "Stop watching"}}, "expect": {"text": "No ticker watched"}},
    {"n": 6, "journey": "J-05", "action": {"type": "goto", "url": "/structure"}, "expect": {"text": "Structure"}},
    {"n": 7, "journey": "J-05", "action": {"type": "fill", "target": {"placeholder": "e.g. PG"}, "text": "AAPL"}},
    {"n": 8, "journey": "J-05", "action": {"type": "fill", "target": {"placeholder": "2026-06-09T21:00:00Z"}, "text": "2026-06-22T21:00:00Z"}},
    {"n": 9, "journey": "J-05", "action": {"type": "click", "target": {"role": "button", "name": "Load"}}, "expect": {"text": "300.11"}},
    {"n": 10, "journey": "J-05", "action": {"type": "click", "target": {"testid": "case-studies-row"}}, "expect": {"target": {"testid": "case-drillin"}}}
  ]
}
