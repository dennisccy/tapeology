# Base URL of the Tapeology backend (FastAPI). The WebSocket URL is derived from this by
# swapping http -> ws. The QA harness sets NEXT_PUBLIC_API_URL automatically; for local dev
# either NEXT_PUBLIC_API_URL or NEXT_PUBLIC_API_BASE works. Defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000
