# Tapeology backend environment — copy to `.env` and fill in to enable real-data modes.
#
# This is the ONLY committable env file. It documents variable NAMES with EMPTY secret values;
# never commit a real key. With these blank (the default), the app runs simulator-only and the
# Live / Historical modes report an explicit "real-data provider unavailable" — they never
# fabricate or fall back to simulated data.
#
# Credentials are read from the environment ONLY (see app/providers/adapters/alpaca.py). They
# are NOT part of the engine config. Get a free Alpaca key at https://alpaca.markets.

# Alpaca API credentials (real Live / Historical data). Both must be set to enable real modes.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Market-data feed. Alpaca's free feed is IEX (the default if unset). Non-secret config.
ALPACA_FEED=iex
